# SnapGut — self-hosted configuration
# Copy this file to .env and fill in the values you need.

# ─── Server ─────────────────────────────────────────────────────────────────

# Port the server listens on (default: 8080)
PORT=8080

# Address to bind to. Use 127.0.0.1 for local-only or 0.0.0.0 for all interfaces.
BIND_HOST=127.0.0.1

# The public URL this instance is reachable at (optional). Declarative only.
# It used to switch on sitemap, robots.txt Allow rules, and canonical/og:url tags
# for the marketing pages. Those pages are gone: robots.txt is always
# "Disallow: /", every response carries X-Robots-Tag: noindex, and no sitemap is
# built. Setting this now changes no response — it is validated at boot, carried
# on the config, and kept as the one place an absolute public URL is declared.
# Example: https://diary.example.com
PUBLIC_ORIGIN=

# Require HTTPS on all requests (default: false). Enable when behind a TLS proxy.
REQUIRE_HTTPS=

# How the client IP is derived for rate limiting: none, xff, or cloudflare (default: none)
# "none" and "xff" are the SAME derivation today - the rightmost X-Forwarded-For entry,
# which is the one entry a client cannot forge, or the shared key "local" when no
# forwarding header is present. They differ only in stated intent: "none" means no proxy
# is expected, "xff" means a reverse proxy or tunnel is. "cloudflare" reads CF-Connecting-IP.
TRUSTED_PROXY=none

# ─── Data ────────────────────────────────────────────────────────────────────

# Directory for persistent data: the database and session secret file (default: /data)
DATA_DIR=/data

# Path to the SQLite database file (default: ${DATA_DIR}/snapgut.db)
DB_PATH=

# Datastore backend: sqlite or memory (default: sqlite)
# "memory" loses all data on restart — use only for development.
DATASTORE_BACKEND=sqlite

# ─── Food Pack ───────────────────────────────────────────────────────────────

# Directory containing the food illustration .webp files (default: ./food-pack)
FOOD_PACK_DIR=./food-pack

# ─── AI Provider ─────────────────────────────────────────────────────────────

# Which AI provider to use (default: ollama):
#   ollama, openai, openai-compatible, litellm, anthropic, gemini, mock
# Use openai-compatible for vLLM, LM Studio, llama.cpp, OpenRouter, Groq, Together,
# Fireworks, DeepSeek, Mistral or text-generation-webui.
AI_PROVIDER=ollama

# Base URL for the AI provider API. Trailing slashes are stripped, and a base URL that
# already ends in /v1 is not doubled when the OpenAI-style path is appended.
# Defaults: ollama http://127.0.0.1:11434, openai https://api.openai.com,
#   litellm http://127.0.0.1:4000, anthropic https://api.anthropic.com,
#   gemini https://generativelanguage.googleapis.com.
# Required for openai-compatible — there is no sensible default.
# For Docker: use http://host.docker.internal:11434 to reach host Ollama.
AI_BASE_URL=

# Model name (provider-specific). Example: llama3.2-vision
# REQUIRED for every provider except mock - there is no usable default. An empty model is
# rejected by Ollama, the OpenAI-shaped providers and Anthropic, and 404s on Gemini, so the
# server refuses to start without it rather than failing at the first recognition.
AI_MODEL=

# API key for the AI provider. Required for gemini and anthropic, optional for
# openai, openai-compatible and litellm (not needed for ollama or mock).
AI_API_KEY=

# Request timeout in milliseconds (default: 120000). Must be greater than zero.
# The timeout CANNOT be disabled: the value goes straight to AbortSignal.timeout(), and
# AbortSignal.timeout(0) fires immediately, aborting every AI request. 0, a negative value
# and a non-numeric value are all boot errors. For a slow local model raise it (e.g. 300000).
AI_TIMEOUT_MS=120000

# Structured-output mode: auto, json_object, or off (default: auto)
# "auto" sends each provider's native JSON field (Ollama format, OpenAI response_format,
# Gemini responseMimeType). "off" sends none of them — use it when a gateway rejects
# response_format with a 400. The prompt still asks for JSON either way.
AI_JSON_MODE=auto

# Extra request headers as a JSON object of string values (default: none).
# Useful for gateways that want attribution headers. Auth and Content-Type headers set
# by the adapter always win, so these cannot break authentication.
# Example: {"HTTP-Referer":"https://example.com","X-Title":"SnapGut"}
AI_EXTRA_HEADERS=

# ─── Authentication ──────────────────────────────────────────────────────────

# Email address used as the account identity (default: admin@localhost)
AUTH_EMAIL=admin@localhost

# Password for signing in. Minimum 12 characters (leading and trailing
# whitespace is trimmed and does not count). A value that is unset,
# whitespace-only, or shorter than 12 characters is treated as no credential at
# all: every sign-in request is rejected.
# IMPORTANT: the server REFUSES TO START when BIND_HOST is an exposed
# (non-loopback) address and this is unset or under 12 characters. On loopback it
# only logs a warning.
AUTH_PASSWORD=

# ─── Session ─────────────────────────────────────────────────────────────────

# Session signing secret (min 32 characters). If unset, one is auto-generated
# and persisted to ${DATA_DIR}/session-secret.
SESSION_SECRET=
