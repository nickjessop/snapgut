# SnapGut — self-hosted configuration
# Copy this file to .env and fill in the values you need.

# ─── Server ─────────────────────────────────────────────────────────────────

# Port the server listens on (default: 8080)
PORT=8080

# Address to bind to. Use 127.0.0.1 for local-only or 0.0.0.0 for all interfaces.
BIND_HOST=127.0.0.1

# The public URL this instance is reachable at (optional).
# When set, enables sitemap, robots.txt Allow rules, and canonical/og:url tags.
# Example: https://diary.example.com
PUBLIC_ORIGIN=

# Require HTTPS on all requests (default: false). Enable when behind a TLS proxy.
REQUIRE_HTTPS=

# Trusted proxy for X-Forwarded-* headers: none, xff, or cloudflare (default: none)
TRUSTED_PROXY=none

# ─── Data ────────────────────────────────────────────────────────────────────

# Directory for persistent data: the database and session secret file (default: /data)
DATA_DIR=/data

# Path to the SQLite database file (default: ${DATA_DIR}/snapgut.db)
DB_PATH=

# Datastore backend: sqlite or memory (default: sqlite)
# "memory" loses all data on restart — use only for development.
DATASTORE_BACKEND=sqlite

# ─── Food Pack ───────────────────────────────────────────────────────────────

# Directory containing the food illustration .webp files (default: ./food-pack)
FOOD_PACK_DIR=./food-pack

# ─── AI Provider ─────────────────────────────────────────────────────────────

# Which AI provider to use: ollama, openai, gemini, or mock (default: ollama)
AI_PROVIDER=ollama

# Base URL for the AI provider API.
# Default for ollama: http://127.0.0.1:11434
# For Docker: use http://host.docker.internal:11434 to reach host Ollama.
AI_BASE_URL=

# Model name (provider-specific). Example: llama3.2-vision
AI_MODEL=

# API key for openai or gemini providers (not needed for ollama or mock)
AI_API_KEY=

# Request timeout in milliseconds (default: 120000)
AI_TIMEOUT_MS=120000

# ─── Authentication ──────────────────────────────────────────────────────────

# Email address used as the account identity (default: admin@localhost)
AUTH_EMAIL=admin@localhost

# Password for signing in. When unset, the diary is accessible without auth.
# IMPORTANT: Set this before exposing the instance to a network.
AUTH_PASSWORD=

# ─── Session ─────────────────────────────────────────────────────────────────

# Session signing secret (min 32 characters). If unset, one is auto-generated
# and persisted to ${DATA_DIR}/session-secret.
SESSION_SECRET=
