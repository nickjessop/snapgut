{
  "name": "snapgut",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/main.js\"",
    "build": "vite build",
    "icons": "node scripts/gen-icons.mjs",
    "og": "node scripts/gen-og.mjs",
    "brand": "node scripts/gen-brand.mjs",
    "start": "node server/main.js",
    "preview": "npm run build && node server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.6.14",
    "idb": "^8.0.0",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
